# Salin menjadi .env (start.bat melakukannya otomatis) lalu isi nilainya. JANGAN commit .env.
# Prototype jalan TANPA mengisi apa pun: jalur aturan tidak butuh API key.

# =====================================================================
# A. DIPAKAI PROTOTYPE SEKARANG (semua opsional)
# =====================================================================

# Isi supaya jalur LLM ikut mengklasifikasi tanda bahaya (OR-gate) dan
# mengekstrak fakta cerita Mbah untuk memori. Kosong = jalur aturan saja.
OPENAI_API_KEY=
# Model pengklasifikasi. Kosong = gpt-6-luna.
OPENAI_MODEL_CLASSIFIER=
# Ganti hanya bila memakai endpoint kompatibel OpenAI lain (mis. proxy/Azure).
OPENAI_BASE_URL=https://api.openai.com/v1
# Batas waktu panggilan LLM (detik). Lewat batas = lanjut jalur aturan.
TILIK_LLM_TIMEOUT_S=6
# Nama puskesmas yang tampil di pesan/rapor.
TILIK_PUSKESMAS_NAME=Puskesmas Wonosari I (simulasi)

# =====================================================================
# B. BELUM DIPAKAI: untuk pipeline telepon sungguhan (Stage 2)
#    Boleh dibiarkan kosong. Lihat docs/stage-0/03_ARSITEKTUR_TEKNIS.md
# =====================================================================

# Mode demo selalu true di docker-compose. Server suara (apps/voice) hanya menelepon nomor ini.
# 119/112 dan nomor darurat lain tidak pernah ditelepon, apa pun isinya.
DEMO_ALLOWLIST=+62xxxxxxxxxx,+62xxxxxxxxxx
# Nomor default yang ditelepon POST /calls server suara (HP anggota tim yang jadi "Mbah"). Harus ada di allowlist.
DEMO_PATIENT_PHONE=

OPENAI_MODEL_DIALOG=

# --- Server suara apps/voice (lihat apps/voice/README.md) ---
# Wajib untuk suara: STT + TTS. Kosong = server tetap jalan tapi tidak bisa mendengar/bicara.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Kosong = eleven_flash_v2_5 (latensi rendah, mendukung bahasa Indonesia)
ELEVENLABS_TTS_MODEL=
# Kosong = scribe_v2_realtime
ELEVENLABS_STT_MODEL=
# Kosong = id
ELEVENLABS_STT_LANGUAGE=
# Suara "Mbah" untuk simulator scripts/webrtc_sim.py. Kosong = sama dengan ELEVENLABS_VOICE_ID.
ELEVENLABS_SIM_VOICE_ID=
# Alamat API dialog dan port server suara
TILIK_API_URL=http://127.0.0.1:8080
VOICE_PORT=7860
# Jeda hening (detik) sebelum giliran Mbah dianggap selesai
TILIK_VAD_STOP_SECS=0.7

TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
# Detik berdering sebelum dianggap tidak diangkat
TWILIO_RING_TIMEOUT_S=30

# URL publik server suara (Cloudflare Quick Tunnel, berubah tiap dijalankan)
PUBLIC_BASE_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=

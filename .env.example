# Salin menjadi .env dan isi nilainya. JANGAN commit .env.
# Lihat docs/stage-0/03_ARSITEKTUR_TEKNIS.md dan docs/stage-0/09_STAGE0_CHECKLIST.md

# --- Mode ---
# true = semua panggilan/WA hanya ke nomor di DEMO_ALLOWLIST, tidak pernah ke 119/RS sungguhan
DEMO_MODE=true
DEMO_ALLOWLIST=+62xxxxxxxxxx,+62xxxxxxxxxx

# --- OpenAI (model ditentukan di spike S-04) ---
OPENAI_API_KEY=
OPENAI_MODEL_DIALOG=
OPENAI_MODEL_CLASSIFIER=

# --- ElevenLabs (model & voice ditentukan di spike S-02/S-03) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_STT_MODEL=
ELEVENLABS_STT_LANGUAGE=

# --- Twilio (akun trial) ---
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=

# --- URL publik server suara (Cloudflare Quick Tunnel, berubah tiap dijalankan) ---
PUBLIC_BASE_URL=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp Cloud API ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
